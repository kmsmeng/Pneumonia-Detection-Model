# Data (Kaggle download + generated YOLO dataset).
# No trailing slash: on the cluster, data is a symlink (a file), which "data/" would not match.
/data
.kaggle/

# Secrets
.env

# Virtual environments
myenv/
.venv/

# Model weights & training outputs (versioned in W&B instead)
models/
runs/
*.pt
*.onnx
*.torchscript
wandb/

# Python / Jupyter
__pycache__/
.ipynb_checkpoints/

# SLURM job logs
slurm/logs/*
!slurm/logs/.gitkeep
